{
  "appId": "top.yinziapi.ai-video-workflow.universal",
  "productName": "银子AI视频工作流-通用版-老李兼容",
  "executableName": "银子AI视频工作流-通用版-老李兼容",
  "npmRebuild": false,
  "electronVersion": "43.4.0",
  "directories": {
    "output": "release-universal"
  },
  "files": [
    "main.js",
    "runtime.js",
    "package.json",
    "LICENSE.txt",
    "THIRD_PARTY_NOTICES.txt",
    "backend-app/**/*",
    "node_modules/**/*",
    "!node_modules/**/*.unused-*/**",
    "!node_modules/@img/sharp-wasm32/**",
    "!node_modules/@emnapi/**"
  ],
  "asarUnpack": [
    "node_modules/better-sqlite3/**",
    "node_modules/sharp/**",
    "node_modules/@img/**"
  ],
  "extraResources": [
    {
      "from": "frontweb-dist",
      "to": "frontweb/dist",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../example_drama",
      "to": "example_drama",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../backend-node/tools/ffmpeg",
      "to": "ffmpeg",
      "filter": [
        "ffmpeg.exe",
        "ffprobe.exe",
        "LICENSE-FFMPEG-GPLv3.txt",
        "README-FFMPEG-BUILD.txt"
      ]
    },
    {
      "from": "release-docs",
      "to": "docs",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../NOTICE.md",
      "to": "NOTICE.md"
    },
    {
      "from": "../THIRD_PARTY_NOTICES.md",
      "to": "THIRD_PARTY_NOTICES.md"
    },
    {
      "from": "../licenses",
      "to": "licenses"
    }
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "build/icon.ico",
    "artifactName": "银子AI视频工作流-通用版-老李兼容-Portable-${version}-x64.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "preCompressedFileExtensions": [],
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "银子AI视频工作流-通用版-老李兼容",
    "artifactName": "银子AI视频工作流-通用版-老李兼容-Setup-${version}-x64.${ext}",
    "deleteAppDataOnUninstall": false,
    "installerLanguages": [
      "zh_CN"
    ],
    "language": "2052"
  }
}
