  "local.image.frequency-separation": {
    "type": "object",
    "description": "高低频分频分离与修饰：将图像分解为色彩基底（低频）与质感细节（高频），支持消除杂色色斑或增强锐利纹理。",
    "properties": {
      "radius": {
        "type": "number",
        "description": "分频分离高斯半宽",
        "minimum": 1,
        "maximum": 64,
        "default": 4
      },
      "texture_gain": {
        "type": "number",
        "description": "高频质感增益系数，>1.0 为强化纹理锐利度",
        "minimum": 0,
        "maximum": 3,
        "default": 1.2
      },
      "color_blur_blend": {
        "type": "number",
        "description": "基底色彩进一步平滑比例，消除杂色斑驳",
        "minimum": 0,
        "maximum": 1,
        "default": 0.4
      }
    }
  },
  "local.image.bilateral-denoise": {
    "type": "object",
    "description": "根据原图与高斯引导层的亮度差异调整降噪权重，保留较强边缘。",
    "properties": {
      "spatial_sigma": {
        "type": "number",
        "description": "空间邻域半宽",
        "minimum": 1,
        "maximum": 20,
        "default": 3
      },
      "edge_threshold": {
        "type": "number",
        "description": "边缘反差保护阈值，越小对微弱边缘越敏感保护",
        "minimum": 5,
        "maximum": 120,
        "default": 30
      },
      "mix": {
        "type": "number",
        "description": "降噪平滑混合度",
        "minimum": 0,
        "maximum": 1,
        "default": 0.75
      }
    }
  },
  "local.image.dodge-burn": {
    "type": "object",
    "description": "局部加光与减光立体塑造：针对高光、阴影与中间调重塑反差光影，增强人像面部立体感与质感。",
