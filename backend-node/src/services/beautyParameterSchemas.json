{
  "local.image.face-beauty": {
    "type": "object",
    "description": "本地保纹理人脸美颜：基于高低频分频分离与五官（眼、眉、唇）保护，针对检测人脸或指定区域进行磨皮软化、皮肤质感保持与肤色润饰，支持无脸安全退路与 EXIF 自动定向方向同步。",
    "properties": {
      "smooth_strength": {
        "type": "number",
        "description": "磨皮平滑强度，0 为不平滑，1 为最大平滑，默认 0.6",
        "minimum": 0,
        "maximum": 1,
        "default": 0.6
      },
      "texture_retention": {
        "type": "number",
        "description": "高频皮肤毛孔纹理保留比例，0 为塑料感无纹理，1 为完全保留原纹理，默认 0.7",
        "minimum": 0,
        "maximum": 1,
        "default": 0.7
      },
      "feature_protection": {
        "type": "number",
        "description": "五官（眼睛、睫毛、眉毛、唇部）保护力度，避免五官模糊失真，默认 0.85",
        "minimum": 0,
        "maximum": 1,
        "default": 0.85
      },
      "skin_tone_warmth": {
        "type": "number",
        "description": "肤色暖度微调，正数为暖黄红润，负数为冷白，默认 0.05",
        "minimum": -0.5,
        "maximum": 0.5,
        "default": 0.05
      },
      "skin_brighten": {
        "type": "number",
        "description": "肤色局部提亮微调，默认 0.08",
        "minimum": -0.5,
        "maximum": 0.5,
        "default": 0.08
      },
      "skin_rosiness": {
        "type": "number",
        "description": "肤色局部红润气色微调，默认 0.04",
        "minimum": -0.5,
        "maximum": 0.5,
        "default": 0.04
      },
      "feather_ratio": {
        "type": "number",
        "description": "美颜作用区域边缘羽化过渡带比例，防止生硬方形切边，默认 0.25",
        "minimum": 0.05,
        "maximum": 0.5,
        "default": 0.25
      },
      "expand_ratio": {
        "type": "number",
        "description": "人脸检测框外扩比例，覆盖脸颊下巴边缘，默认 0.2",
        "minimum": 0,
        "maximum": 1,
        "default": 0.2
      },
      "face_selection": {
        "type": "string",
        "description": "多脸选择策略：all(所有人脸), largest(面积最大), primary(居中主要), index(指定序号)",
        "enum": [
          "all",
          "largest",
          "primary",
          "index"
        ],
        "default": "all"
      },
      "target_index": {
        "type": "integer",
        "description": "face_selection 为 index 时的人脸序号 (0 起始)",
        "minimum": 0,
        "maximum": 99,
        "default": 0
      },
      "score_threshold": {
        "type": "number",
        "description": "YuNet 人脸检测置信度阈值",
        "minimum": 0.1,
        "maximum": 0.99,
        "default": 0.6
      },
      "force_user_rect": {
        "type": "boolean",
        "description": "跳过自动检测，强制使用 user_rect 手动指定的美颜区域",
        "default": false
      },
      "user_rect": {
        "type": "object",
        "description": "归一化矩形区域退路或手动指定框",
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "width": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "height": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "nms_threshold": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.3
      },
      "top_k": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5000,
        "default": 500
      },
      "max_faces": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 100
      },
      "max_pixels": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 40000000,
        "default": 24000000
      },
      "detection_size": {
        "type": "integer",
        "enum": [
          640
        ],
        "default": 640,
        "description": "锁定ONNX模型的固定输入尺寸；原图按比例缩放并填充，定位映射回原尺寸"
      }
    }
  },
