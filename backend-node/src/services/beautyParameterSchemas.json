      "feather_ratio": {
        "type": "number",
        "description": "边缘羽化比例 (0.05~0.5)，默认 0.25",
        "minimum": 0.05,
        "maximum": 0.5,
        "default": 0.25
      },
      "expand_ratio": {
        "type": "number",
        "description": "人脸检测框外扩比例 (0~1)，默认 0.2",
        "minimum": 0,
        "maximum": 1,
        "default": 0.2
